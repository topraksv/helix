  "engines": {
    "node": "^22"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.110.8",
    "babel-preset-expo": "~54.0.12",
    "drizzle-orm": "^0.45.2",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.19",
    "lucide-react-native": "^1.27.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "socket.io-client": "^4.8.3",
    "uuidv7": "^1.2.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@expo-google-fonts/ibm-plex-serif": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@playwright/test": "^1.62.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/react": "~19.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.10",
    "eas-cli": "21.4.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "fast-check": "^4.9.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.9"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --config vitest.coverage.config.ts",
    "test:mutation": "stryker run",
    "test:e2e:export": "node scripts/export-e2e-web.mjs",
    "test:e2e": "npm run test:e2e:export && playwright test",
    "test:e2e:only": "playwright test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "verify": "npm run quality:audit && npm run typecheck && npm run test:coverage && npx expo lint",
    "bundle:check": "node scripts/check-web-budget.mjs dist --require-supabase-config",
    "test:e2e:smoke": "npm run test:e2e:export && playwright test --grep @smoke",
    "verify:full": "npm run verify && npx expo export -p web --clear && npm run bundle:check && npm run test:e2e",
    "fonts:subset": "node scripts/subset-fonts.mjs",
    "test:native": "PATH=\"/opt/homebrew/opt/openjdk@17/bin:$PATH\" maestro test e2e/native",
    "test:native:ios": ": \"${MAESTRO_DEVICE:?Set MAESTRO_DEVICE to an iOS simulator UDID}\"; PATH=\"/opt/homebrew/opt/openjdk@17/bin:$PATH\" maestro --device \"$MAESTRO_DEVICE\" test e2e/native",
    "test:native:android": "PATH=\"/opt/homebrew/opt/openjdk@17/bin:$PATH\" maestro --platform android test e2e/native",
    "test:native:local": "PATH=\"/opt/homebrew/opt/openjdk@17/bin:$PATH\" maestro test e2e/native-local",
    "test:native:local:ios": ": \"${MAESTRO_DEVICE:?Set MAESTRO_DEVICE to an iOS simulator UDID}\"; PATH=\"/opt/homebrew/opt/openjdk@17/bin:$PATH\" maestro --device \"$MAESTRO_DEVICE\" test e2e/native-local",
    "test:native:local:android": "PATH=\"/opt/homebrew/opt/openjdk@17/bin:$PATH\" maestro --platform android test e2e/native-local",
    "ios:build": "expo run:ios --device \"iPhone 17 Pro\"",
    "quality:audit": "node scripts/quality-audit.mjs --check",
    "quality:report": "node scripts/quality-audit.mjs --render",
    "audit:unused": "npx --yes knip@6.32.0"
  },
  "private": true,
  "overrides": {
    "qs": "6.15.3",
    "nanoid": "3.3.18",
    "postcss": "^8.5.10",
    "brace-expansion@1": "^1.1.17",
    "brace-expansion@2": "^2.1.3",
    "brace-expansion@5": "^5.0.9",
    "js-yaml@3": "^3.15.1",
    "js-yaml@4": "^4.3.1",
    "socket.io-parser": "^4.2.7",
    "tar": "^7.5.22",
    "eas-cli@21.4.0": {
      "minimatch@5.1.2": "5.1.9"
    },
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
