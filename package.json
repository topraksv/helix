{
  "name": "helix",
  "main": "expo-router/entry",
  "version": "1.3.0",
  "author": "Ömer Toprak Şavlı",
  "license": "UNLICENSED",
  "engines": {
    "node": "^22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "babel-preset-expo": "~57.0.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.19",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "~57.0.16",
    "expo-router": "~57.0.18",
    "expo-screen-capture": "~57.0.2",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "lucide-react-native": "^1.33.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "uuidv7": "^1.2.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@expo-google-fonts/ibm-plex-serif": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/react": "~19.2.10",
    "@vitest/coverage-v8": "4.1.11",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "fast-check": "^4.9.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "node scripts/web-dev-notice.mjs && npm run web:preview",
    "lint": "expo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --config vitest.coverage.config.ts",
    "test:mutation": "stryker run",
    "test:mutation:ci": "stryker run stryker.ci.config.mjs && node scripts/check-mutation-ratchet.mjs",
    "test:e2e:export": "node scripts/export-e2e-web.mjs",
    "test:e2e": "npm run test:e2e:export && playwright test",
    "test:e2e:only": "playwright test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "verify": "npm run typecheck && npm run test:coverage && npx expo lint",
    "bundle:check": "node scripts/check-web-budget.mjs dist --require-supabase-config",
    "test:e2e:smoke": "npm run test:e2e:export && playwright test --grep @smoke",
    "verify:full": "npm run verify && npx expo export -p web --clear && npm run bundle:check && npm run test:e2e",
    "fonts:subset": "node scripts/subset-fonts.mjs",
    "test:native": "xcrun simctl keychain booted reset; PATH=\"/opt/homebrew/opt/openjdk@17/bin:$PATH\" maestro test e2e/native",
    "test:native:ios": ": \"${MAESTRO_DEVICE:?Set MAESTRO_DEVICE to an iOS simulator UDID}\"; xcrun simctl keychain \"$MAESTRO_DEVICE\" reset; PATH=\"/opt/homebrew/opt/openjdk@17/bin:$PATH\" maestro --device \"$MAESTRO_DEVICE\" test e2e/native",
    "test:native:android": "PATH=\"/opt/homebrew/opt/openjdk@17/bin:$PATH\" maestro --platform android test e2e/native",
    "test:native:local": "xcrun simctl keychain booted reset; PATH=\"/opt/homebrew/opt/openjdk@17/bin:$PATH\" maestro test e2e/native-local",
    "test:native:local:ios": ": \"${MAESTRO_DEVICE:?Set MAESTRO_DEVICE to an iOS simulator UDID}\"; xcrun simctl keychain \"$MAESTRO_DEVICE\" reset; PATH=\"/opt/homebrew/opt/openjdk@17/bin:$PATH\" maestro --device \"$MAESTRO_DEVICE\" test e2e/native-local",
    "test:native:local:android": "PATH=\"/opt/homebrew/opt/openjdk@17/bin:$PATH\" maestro --platform android test e2e/native-local",
    "ios:build": "expo run:ios --device \"iPhone 17 Pro\"",
    "audit:unused": "npx --yes knip@6.32.0",
    "mutation:baseline": "node scripts/write-mutation-baseline.mjs",
    "audit:duplication": "npx --yes jscpd@5.0.16 src",
    "web:preview": "npx expo export -p web --clear && node scripts/serve-web-export.mjs dist",
    "web:serve": "node scripts/serve-web-export.mjs dist"
  },
  "private": true,
  "overrides": {
    "qs": "6.16.0",
    "nanoid": "3.3.18",
    "postcss": "^8.5.10",
    "brace-expansion@1": "^1.1.17",
    "brace-expansion@2": "^2.1.3",
    "brace-expansion@5": "^5.0.9",
    "js-yaml@3": "^3.15.1",
    "js-yaml@4": "^4.3.1",
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
