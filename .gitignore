# Dependencies and logs
node_modules/
*.log

# Local environment and secrets
.env*
!.env.example
*.jks
*.key
*.mobileprovision
*.p8
*.p12
*.pem

# Expo, native and build output
.expo/
/android/
/ios/
.kotlin/
/dist/
/dist-e2e/
/graphify-out/
expo-env.d.ts
*.tsbuildinfo

# Test and local analysis output
/coverage/
/playwright-report/
/test-results/
.eslintcache

# Local workbook scratch; committed fixtures under tests/ remain eligible
/*.xlsm
/*.xlsx

# Supabase CLI state
supabase/.temp/

# Editor and OS debris
.DS_Store
.idea/
.vscode/*.local.json
*.orig
*.orig.*
*.rej
*.swp

# Temporary agent workspace (probes, screenshots, intermediate reviews).
# Nothing here is an input to a build or test.
.codex/

# Local AI working set. The skills, the per-tool instruction files and the
# handoff note are real inputs to a local Claude/Codex session, but they are
# not inputs to a build, a test or a deploy — keeping them out of Git stops CI
# from reacting to them and stops the history from carrying vendored prose.
/.claude/
/.ai/
/docs/
/AGENTS.md
/CLAUDE.md
