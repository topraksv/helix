# Dependencies and logs
node_modules/
*.log

# Local environment and secrets
.env*
!.env.example
*.jks
*.key
*.mobileprovision
*.p8
*.p12
*.pem

# Expo, native and build output
.expo/
/android/
/ios/
.kotlin/
/dist/
/dist-e2e/
/graphify-out/
expo-env.d.ts
*.tsbuildinfo

# Test and local analysis output
/coverage/
/reports/mutation/
/.stryker-tmp/
/playwright-report/
/test-results/
.eslintcache

# Local workbook scratch; committed fixtures under tests/ remain eligible
/*.xlsm
/*.xlsx

# Supabase CLI state
supabase/.temp/

# Obsidian opens `docs/` as its vault. Track the files that decide how the
# vault behaves, so a fresh clone opens with the same link format, plugins and
# graph settings. Everything else Obsidian writes there — `workspace.json`
# above all — is this machine's window layout and must not follow the repo.
/docs/.obsidian/*
!/docs/.obsidian/app.json
!/docs/.obsidian/appearance.json
!/docs/.obsidian/core-plugins.json
!/docs/.obsidian/graph.json

# Editor and OS debris
.DS_Store
.idea/
.trash/
.vscode/*.local.json
*.orig
*.orig.*
*.rej
*.swp

# Temporary agent workspace (probes, screenshots, intermediate reviews).
# Nothing here is an input to a build or test.
.codex/

# Source-owned AI control plane. Tool settings remain machine-local, while the
# check script and the vendored skills are recoverable from Git.
# Skills are committed rather than restored on demand so that an upstream
# change is reviewable as a diff instead of arriving silently at install time.
/.claude/*
!/.claude/skills/
!/.claude/skills/**
/.ai/*
!/.ai/scripts/
!/.ai/scripts/*.mjs
/.agents/*
!/.agents/skills/
!/.agents/skills/**

# The code map graphify exports into the docs vault: ~3,250 generated notes,
# rebuilt from the AST by `npm run graph:refresh` and never tracked.
/docs/graph

# TestSprite MCP-flow output: generated Python test scripts and per-run
# recordings, regenerated fresh whenever that flow runs and never an input to
# a build or test. The CLI + deployed-URL flow (the one actually in use)
# tracks its own test definitions and run history remotely and writes
# nothing here.
/testsprite_tests/
/.testsprite/
