{
  "$schema": "https://raw.githubusercontent.com/kucherenko/jscpd/master/apps/jscpd/schema.json",
  "threshold": 1,
  "reporters": ["consoleFull"],
  "format": ["typescript", "tsx"],
  "ignore": [
    "**/node_modules/**",
    "dist/**",
    "dist-e2e/**",
    "docs/graph/**",
    "graphify-out/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    "src/sync/database.types.ts"
  ],
  "absolute": true
}
