# This SDK's tooling breaks silently on Node 24/26 (native TS stripping),
# measured here rather than published by Expo — which states a 22.13.x
# minimum and no maximum. `engines` in package.json is the range; this
# makes npm enforce it instead of only documenting it.
engine-strict=true
# A seven-day quarantine for newly published versions, once npm enforces it.
# `min-release-age` arrived in npm 11.10, and the npm Node 22 ships (10.9)
# ignores the key without a word — measured, its config definitions do not
# contain it. Kept for the toolchain that reads it. Until then the one tree
# resolved beside a credential pins its own date: `deploy-mobile` in
# `.github/workflows/ci.yml`.
min-release-age=7
